# ============================================================
# Summarify Pro — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values

# Zhipu AI API Key (Required)
# Get your API key from: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=your_zhipu_api_key_here

# Flask Secret Key (Required)
# Generate a strong random key for JWT signing
SECRET_KEY=change_this_to_a_random_secret_string