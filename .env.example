# ============================================================
# Summarify Pro — Environment Variables (Template)
# ============================================================

# AI Provider (Zhipu / OpenAI-compatible)
AI_PROVIDER=zhipu
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4-flash

# Supabase
PUBLIC_SUPABASE_URL=your_supabase_url_here
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Get this from Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Flask
SECRET_KEY=your_secret_key_here

# PayPal (required for Premium subscription)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox  # 'sandbox' for testing, 'live' for production
# 👍 PAYPAL_API_BASE is auto-detected from PAYPAL_MODE; only set to override
#    (sandbox: api-m.sandbox.paypal.com / live: api-m.paypal.com)
# PAYPAL_API_BASE=https://api-m.paypal.com
# Get these from: https://developer.paypal.com → Dashboard → My Apps
# 1. Create an app to get Client ID & Secret
# 2. Create a Product + Plan ($7.99/month) in PayPal Dashboard to get Plan ID
PAYPAL_PLAN_ID=your_paypal_plan_id_here

# CORS (comma-separated origins; leave empty to allow all in dev)
CORS_ORIGINS=http://localhost:5000